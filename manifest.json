{
  "manifest_version": 3,
  "name": "YouTube Zhongwen Cards",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Chinese vocabulary flashcards (HSK) from YouTube videos, with German or English translation, for Anki import.",
  "permissions": ["sidePanel", "storage", "tabs", "scripting", "downloads"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://api.supadata.ai/*",
    "https://api.anthropic.com/*"
  ],
  "action": {
    "default_title": "Open YouTube Zhongwen Cards",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["i18n.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
